---
import type { Product } from '../lib/store';

interface Props {
	action: string;
	product?: Product;
}

const { action, product } = Astro.props;
---

<form method="POST" action={action} enctype="multipart/form-data" class="product-form">
	<div class="field">
		<label for="name">ชื่อสินค้า</label>
		<input type="text" id="name" name="name" required value={product?.name ?? ''} />
	</div>

	<div class="field-row">
		<div class="field">
			<label for="price">ราคา (บาท)</label>
			<input type="number" id="price" name="price" required min="0" step="1" value={product?.price ?? ''} />
		</div>
		<div class="field">
			<label for="stock">จำนวนสต็อก</label>
			<input type="number" id="stock" name="stock" required min="0" step="1" value={product?.stock ?? 0} />
		</div>
	</div>

	<div class="field">
		<label for="details">รายละเอียดสินค้า</label>
		<textarea id="details" name="details" rows="4">{product?.details ?? ''}</textarea>
	</div>

	<div class="field">
		<label for="image">รูปสินค้า</label>
		{
			product?.image && (
				<img src={product.image} alt="" class="current-image" />
			)
		}
		<input type="file" id="image" name="image" accept="image/*" required={!product} />
		{product && <p class="hint">ไม่เลือกไฟล์ใหม่ = ใช้รูปเดิม</p>}
	</div>

	<label class="checkbox">
		<input type="checkbox" name="soldOut" checked={product?.soldOut ?? false} />
		สินค้าหมด
	</label>

	<div class="form-actions">
		<button type="submit" class="btn">{product ? 'บันทึกการแก้ไข' : 'เพิ่มสินค้า'}</button>
		<a href="/products" class="btn btn-ghost">ยกเลิก</a>
	</div>
</form>

<style>
	.product-form {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
		max-width: 28rem;
	}

	.field-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-md);
	}

	.field textarea {
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius);
		padding: 0.6em 0.75em;
		background: var(--color-paper);
		font-family: inherit;
		resize: vertical;
	}

	.field input[type='file'] {
		font-size: 0.8125rem;
	}

	.current-image {
		width: 5rem;
		height: 6.25rem;
		object-fit: cover;
		border-radius: var(--radius);
		background: var(--color-paper-sunk);
		margin-bottom: var(--space-2xs);
	}

	.hint {
		margin: 0.3em 0 0;
		font-size: 0.75rem;
		color: var(--color-graphite);
	}

	.checkbox {
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
		font-size: 0.875rem;
		width: fit-content;
	}

	.form-actions {
		display: flex;
		gap: var(--space-sm);
		margin-top: var(--space-xs);
	}
</style>
