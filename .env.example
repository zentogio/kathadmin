# Copy this to .env and fill in real values. .env is gitignored.

ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Any long random string — used to sign the login session cookie.
SESSION_SECRET=change-this-to-a-long-random-string

# Supabase project (Settings → API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY is secret — it bypasses Row Level Security, so
# it must only ever be used server-side (never sent to the browser). All
# reads/writes in this admin app run server-side, so that's fine here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
